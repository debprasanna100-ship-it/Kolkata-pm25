# Copy to .env and fill in only the ones you need.
# The pipeline runs fully in demo mode without any of these.

# --- Ground truth -----------------------------------------------------------
# OpenAQ v3 API key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# --- Weather ----------------------------------------------------------------
# Copernicus CDS (ERA5). Register at https://cds.climate.copernicus.eu
# Then put your key in ~/.cdsapirc (cdsapi reads it automatically):
#   url: https://cds.climate.copernicus.eu/api
#   key: <your-key>
CDSAPI_KEY=

# --- Satellite --------------------------------------------------------------
# Google Earth Engine. Run `earthengine authenticate` once, then set the
# Cloud project id that GEE gives you.
GEE_PROJECT=

# --- Fires ------------------------------------------------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
